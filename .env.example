# Base de datos (SQLite local en desarrollo)
DATABASE_URL="file:./dev.db"

# Secreto para firmar las sesiones. Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# Clave de la API de OpenAI (platform.openai.com/api-keys).
# Si la dejas vacía, la app funciona en "modo demo" con imágenes de prueba gratis.
OPENAI_API_KEY=""

# Modelos (opcionales)
OPENAI_TEXT_MODEL="gpt-5.4-mini"
OPENAI_IMAGE_MODEL="gpt-image-2"
# low | medium | high  (más calidad = más caro por imagen)
OPENAI_IMAGE_QUALITY="medium"

# Carpeta donde se guardan las imágenes generadas
STORAGE_DIR="./storage"

# Límite de capítulos que cada usuario puede generar por día (control de gasto)
DAILY_CHAPTER_LIMIT="3"
# Viñetas por capítulo (mín. 4, máx. 30)
MAX_PANELS="16"
